# Shifara Health - URLs on Apache / LiteSpeed (Hostinger).
#   /hospital/<id>/  /doctor/<id>/  /treatment/<id>/   real folders, served as they are (index.html)
#   /hospitals/  /doctors/  /treatments/                real folders (listing pages)
#   /hospitals/cardiology/delhi/ …                      no folder -> the listing page; filters are read from the path
DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(hospitals|doctors|treatments)/.+$ $1/index.html [L,QSA]
</IfModule>
